# BrandCanon AI Production Environment Configuration Example
# Copy this file to .env and configure strong secrets before running in production.

# Application General
APP_NAME="BrandCanon AI"
APP_ENV=production
DEBUG=false
API_V1_STR=/api/v1

# Security & Tokens
JWT_SECRET=replace_with_strong_random_sha256_jwt_secret_in_production
SESSION_EXPIRY_DAYS=7

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://brandcanon:brandcanon_password@localhost:5432/brandcanon_db

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
PRIVATE_STORAGE_PATH=./private_storage

# AI Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# URLs & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENABLE_DEMO_LOGINS=false
